# Build outputs (regenerated by build.py / build_internal.py).  All of it is
# reproducible from source, so it is not tracked -- archive shipped .wotmod files
# separately if you need to keep a specific release.
/build/
/build_internal/
/dist_internal/

# Third-party .wotmod packages that build.py packs into the release zip.  They
# are other people's builds, redistributed unchanged, so they are not tracked
# here -- drop the unmodified files into vendor/ before running build.py.
/vendor/
/gravity.steel_hunter_ability_helper.2.4.1.1.1.1.1.zip

# Python caches
__pycache__/
*.pyo

# Stray bytecode next to source: build.py compiles into build/, so a .pyc in
# src/ is never part of a release and can silently shadow the .py on import.
/src/*.pyc

# Editor / OS noise
*.swp
*~
Thumbs.db
.desktop.ini

# Private working notes, kept locally but never published:
# - ARCHITECTURE.md / HANDOVER.md are the author's own internal notes and
#   handover; they reference client internals and machine specific paths.
# - CHANGELOG.md / TAB_PANEL_FINDINGS.md are the per-round fix log and the
#   panel-specific analysis.  Both quote client function names, file names and
#   line numbers, which is development detail rather than user documentation.
#   DEVELOPMENT.md is the public-facing equivalent of all four.
# - _wot/ holds local scratch tooling and extracted client files.
/ARCHITECTURE.md
/HANDOVER.md
/CHANGELOG.md
/CHANGELOG.en.md
/TAB_PANEL_FINDINGS.md
/TAB_PANEL_FINDINGS.en.md
/_wot/
